{
  "entities": {
    "booking": {
      "title": "Booking",
      "description": "Barbershop reservation with deposit, payment and commission tracking",
      "type": "object",
      "properties": {
        "bookingCode": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerNote": { "type": "string" },
        "barberId": { "type": "string" },
        "barberName": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "servicePrice": { "type": "number" },
        "depositAmount": { "type": "number" },
        "depositPaid": { "type": "boolean" },
        "depositPaidAt": { "type": "number" },
        "remainingAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "paymentStatus": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "commissionRate": { "type": "number" },
        "commissionAmount": { "type": "number" },
        "shopAmount": { "type": "number" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["bookingCode", "customerName", "customerPhone", "serviceName", "servicePrice", "date", "timeSlot", "status"]
    },
    "barber": {
      "title": "Barber",
      "description": "Barber profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "nickname": { "type": "string" },
        "status": { "type": "string" },
        "commissionRate": { "type": "number" }
      }
    },
    "service": {
      "title": "Service",
      "description": "Haircut or grooming service option",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "durationMinutes": { "type": "number" }
      }
    },
    "shopInfo": {
      "title": "ShopInfo",
      "description": "Shop configuration, promptpay QR account and settings",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "promptPayNumber": { "type": "string" },
        "promptPayName": { "type": "string" },
        "depositAmount": { "type": "number" },
        "requireDeposit": { "type": "boolean" },
        "defaultCommissionRate": { "type": "number" }
      }
    },
    "expense": {
      "title": "Expense",
      "description": "Shop expense record for accounting",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "date": { "type": "string" },
        "note": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["title", "amount", "category", "date"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Payment income or commission payout transaction",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "bookingId": { "type": "string" },
        "barberId": { "type": "string" },
        "barberName": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "commissionAmount": { "type": "number" },
        "shopAmount": { "type": "number" },
        "date": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/bookings/{bookingId}": {
      "schema": "booking",
      "description": "Customer bookings"
    },
    "/barbers/{barberId}": {
      "schema": "barber",
      "description": "Barber profiles"
    },
    "/services/{serviceId}": {
      "schema": "service",
      "description": "Barber services"
    },
    "/shop_info/{docId}": {
      "schema": "shopInfo",
      "description": "Shop settings and PromptPay details"
    },
    "/expenses/{expenseId}": {
      "schema": "expense",
      "description": "Shop expense records"
    },
    "/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "Financial income and payout transactions"
    }
  }
}
